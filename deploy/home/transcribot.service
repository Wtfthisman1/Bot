# Автозапуск бота на домашней машине.
#
# Ставится скриптом deploy/home/setup-service.sh — он подставляет сюда
# фактические пути. Значения ниже — те, что были на момент написания.
#
# Ключевое: бот не переживал перезагрузку, потому что запускался руками из
# терминала. Здесь же он поднимается при старте машины и перезапускается,
# если упал.

[Unit]
Description=Transcribot — Telegram-бот расшифровки (Whisper + yt-dlp)
# Туннель нужен не для запуска, а для ссылок наружу: без сети бот стартует,
# но ссылки не откроются, поэтому ждём именно поднятую сеть
# База живёт в контейнере (docker compose up -d postgres) и стартует вместе с
# Docker. Без неё бот не поднимется: в базе очередь задач.
After=network-online.target wg-quick@wg0.service docker.service
Wants=network-online.target docker.service
# Ключи живут в [Unit]: в [Service] systemd их игнорирует.
#
# Было три попытки за минуту — «три падения подряд это сломанная конфигурация».
# С привязкой к адресу туннеля (server.address) это стало вредным: wg0
# поднимается не мгновенно, и служба сдавалась раньше, чем появлялся адрес, —
# то есть не поднималась уже никогда. Десять попыток за десять минут по-прежнему
# ловят сломанный конфиг, но переживают медленный старт сети.
StartLimitBurst=10
StartLimitIntervalSec=600

[Service]
Type=simple
User=dmitry
Group=dmitry
WorkingDirectory=/home/dmitry/IdeaProjects/Bot

# .env читается из рабочего каталога самим приложением
# (DotenvEnvironmentPostProcessor), поэтому EnvironmentFile здесь не нужен —
# иначе токен пришлось бы держать в двух местах.
ExecStart=/usr/bin/java -jar /home/dmitry/IdeaProjects/Bot/build/libs/bot.jar

# yt-dlp лежит в /usr/local/bin, а deno — в домашнем каталоге; урезанный PATH
# systemd их не видит. Каталог deno приложение добавляет само
# (downloader.js-runtime-dir), здесь — остальное.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/dmitry

# По умолчанию поднимаются обе половины — и приём запросов, и исполнение.
# После переезда бота на VPS дом должен перестать читать апдейты: getUpdates
# Telegram отдаёт одному процессу, и два long polling начнут отбирать их друг
# у друга (в логах — 409 Conflict). Делается это drop-in-файлом, а не правкой
# юнита: состояние конкретной машины не должно расходиться с репозиторием, а
# откат — это удаление одного файла. Команда — в deploy/README.md, шаг 4.


# ── Закалка. Смысл в том, чтобы выполнение чужого кода внутри приложения не
# превращалось сразу во власть над машиной: без этих строк процесс видел всю
# файловую систему ровно так же, как пользователь, от которого запущен.
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
# ProtectSystem=full, а не strict: при strict вся файловая система, включая
# /home, становится только для чтения, и тогда пришлось бы перечислять в
# ReadWritePaths не только upload и logs, но и кеш моделей Whisper, и каталог
# deno. Ошибиться здесь — значит уронить расшифровку на середине уже в бою,
# поэтому сначала так: /usr и /boot закрыты, дом остаётся рабочим.
ProtectSystem=full

Restart=always
RestartSec=10

# Логи бот пишет сам в logs/app.log; в журнал уходит только то, что не поймал
# logback (например, ошибка старта JVM)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=transcribot

# Мягкая остановка. Очередь живёт в Postgres, и задача, прерванная на середине,
# вернётся в очередь при следующем старте (JobStore.recoverStuck) — ждать
# часами при выключении машины всё равно нельзя.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
