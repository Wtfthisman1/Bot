# Ежедневная резервная копия.

[Unit]
Description=Ежедневная резервная копия Transcribot

[Timer]
# 04:00 — после ночной чистки файлов в 2:00 (FileCleanupWorker), чтобы копия
# отражала уже прибранное состояние, а не то, что вот-вот удалят
OnCalendar=*-*-* 04:00:00
# Домашняя машина ночью бывает выключена. Без Persistent пропущенный запуск
# просто теряется — а так копия снимется при первом же включении
Persistent=true
# Разброс, чтобы копия не начиналась ровно в момент старта прочих таймеров
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
