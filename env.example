# ========================================
# НАСТРОЙКИ БОТА
# ========================================
BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_admin_chat_id_here

# ========================================
# НАСТРОЙКИ СЕРВЕРА
# ========================================
# ВАЖНО: по этим адресам пользователь открывает форму загрузки и качает файлы.
# Адрес должен быть доступен ИЗВНЕ, с телефона по мобильному интернету, а не
# только из вашей локальной сети. Проверить: curl <адрес>/actuator/health
# с любого устройства вне домашнего Wi-Fi.
#
# Вариант 1 — VPS-релей с белым IP (рекомендуется): указывайте его адрес.
# Сам бот и обработка остаются на этой машине, VPS только проксирует запросы.
# UPLOAD_BASE_URL=https://files.example.com
# DOWNLOAD_BASE_URL=https://files.example.com
#
# Вариант 2 — только локальная сеть (ссылки НЕ откроются с мобильного интернета):
UPLOAD_BASE_URL=http://192.168.1.221:8080
DOWNLOAD_BASE_URL=http://192.168.1.221:8080

# Адрес самого сайта: из него бот собирает одноразовую ссылку входа в кабинет.
# Пусто — берётся UPLOAD_BASE_URL: это один и тот же домен, и разводить две
# переменные ради одного значения незачем.
# SITE_BASE_URL=https://files.example.com

# ========================================
# НАСТРОЙКИ БАЗЫ ДАННЫХ
# ========================================
# Обязательны: без базы бот не стартует — в ней очередь задач и расшифровки.
# Поднимается так: docker compose up -d postgres
DB_HOST=localhost
# 5433, а не 5432: стандартный порт часто занят другим Postgres на той же машине
DB_PORT=5433
DB_NAME=bot_db
DB_USER=bot_user
DB_PASSWORD=смените_на_длинный_случайный

# ========================================
# РАЗДЕЛЕНИЕ: БОТ НА VPS, ИСПОЛНЕНИЕ ДОМА
# ========================================
# Общий ключ внутреннего API. Один и тот же с обеих сторон: дом им проверяет
# входящие запросы, бот на VPS — подписывает свои. Пустое значение означает
# «внутрь никого» и годится, пока обе половины в одном процессе.
# Сгенерировать: openssl rand -base64 32
HOME_API_KEY=

# Задаётся ТОЛЬКО на VPS (см. deploy/vps/setup-bot.sh): адрес домашней машины
# внутри туннеля. Дома эта переменная не нужна — там очередь под рукой.
# HOME_API_URL=http://10.8.0.2:8080

# Куда складывать задачи, принятые при спящем доме. По умолчанию — каталог
# spool рядом с приложением; на VPS это /opt/transcribot/spool.
# SPOOL_DIR=/opt/transcribot/spool

# ========================================
# САЙТ: АККАУНТЫ, КВОТА, ВХОД
# ========================================
# Задаётся только там, где поднята домашняя половина: сайт живёт рядом с базой.

# Сколько расшифровок в месяц бесплатно. Скачивание файлов в лимит не входит.
QUOTA_ENABLED=true
QUOTA_FREE_PER_MONTH=3
# По этому поясу начинается месяц: по UTC лимит обновлялся бы посреди ночи
QUOTA_ZONE=Europe/Moscow

# Вход через Google. Пусто — кнопки просто нет, всё остальное работает.
# Ключи: console.cloud.google.com → Credentials → OAuth client ID → Web.
# Адрес возврата: https://<домен>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Вход через Telegram ключей не требует: подпись виджета проверяется токеном
# бота. Но домен нужно привязать к боту в @BotFather командой /setdomain.
# Регистрации по номеру телефона нет и не планируется — нужен платный SMS-шлюз.

# На каком адресе слушать. Пусто — на всех интерфейсах, то есть сайт и
# внутренний API видны любому устройству домашней сети: мимо nginx, мимо
# HTTPS и мимо ограничения попыток входа (оно верит X-Real-IP, который
# перезаписывает nginx, — а напрямую этот заголовок присылает кто угодно).
# Дома укажите адрес машины в туннеле WireGuard (у нас — 10.8.0.2). Локальной
# разработке оставьте пусто.
#
# Про «служба не стартует, пока не поднят wg0»: этого не происходит, если
# поставлен deploy/home/99-transcribot-bind.conf (его кладёт setup-service.sh).
# С ним привязка к ещё не появившемуся адресу разрешена ядром.
SERVER_ADDRESS=10.8.0.2

# То же самое для запуска в Docker: на каком адресе хоста публиковать порт
# 8080. Пусто = 127.0.0.1 (nginx на этой же машине); 10.8.0.2 — если запросы
# приходят с VPS по туннелю. Внутри контейнера приложение при этом слушает
# все интерфейсы, иначе порт не пробросить.
BIND_ADDRESS=127.0.0.1

# Куку сессии отдавать только по HTTPS. В проде — true (снаружи всё идёт через
# nginx с сертификатом); при локальной разработке по http оставить false,
# иначе браузер не сохранит сессию и вход будет слетать.
SESSION_COOKIE_SECURE=false

# ========================================
# НАСТРОЙКИ ЛОГИРОВАНИЯ
# ========================================
# Управляет ТОЛЬКО подробностью консоли и logs/app.log.
# Пофайловые логи задач (logs/jobs/job-<id>.log) всегда пишутся с полной
# детализацией, включая построчный вывод yt-dlp и Whisper.
LOG_LEVEL=INFO

# ── Диаризация: кто говорит (фаза 4) ──
# Токен Hugging Face (Read). Кроме токена нужно один раз принять условия
# моделей pyannote/speaker-diarization-3.1 и pyannote/segmentation-3.0 тем же
# аккаунтом — без этого веса не отдаются, и диаризация молча пропускается.
HF_TOKEN=
# Включает второй проход. Без HF_TOKEN не имеет смысла
DIARIZE_ENABLED=false
# Если число собеседников известно заранее, подскажите его — разметка точнее
DIARIZE_MIN_SPEAKERS=
DIARIZE_MAX_SPEAKERS=

# ── Обработка текста моделью: выжимка и разбор по теме (фаза 5) ──
# Нужна Ollama на этой же машине: curl -fsSL https://ollama.com/install.sh | sh
# и один раз скачать модель: ollama pull qwen2.5:7b-instruct
INSIGHT_ENABLED=false
INSIGHT_MODEL=qwen2.5:7b-instruct
# Окно модели. 8192 токена — компромисс с Whisper: они делят одни 8 ГБ видеопамяти
INSIGHT_NUM_CTX=8192
