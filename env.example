# ========================================
# НАСТРОЙКИ БОТА
# ========================================
BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_admin_chat_id_here

# ========================================
# НАСТРОЙКИ СЕРВЕРА
# ========================================
# ВАЖНО: по этим адресам пользователь открывает форму загрузки и качает файлы.
# Адрес должен быть доступен ИЗВНЕ, с телефона по мобильному интернету, а не
# только из вашей локальной сети. Проверить: curl <адрес>/actuator/health
# с любого устройства вне домашнего Wi-Fi.
#
# Вариант 1 — VPS-релей с белым IP (рекомендуется): указывайте его адрес.
# Сам бот и обработка остаются на этой машине, VPS только проксирует запросы.
# UPLOAD_BASE_URL=https://files.example.com
# DOWNLOAD_BASE_URL=https://files.example.com
#
# Вариант 2 — только локальная сеть (ссылки НЕ откроются с мобильного интернета):
UPLOAD_BASE_URL=http://192.168.1.221:8080
DOWNLOAD_BASE_URL=http://192.168.1.221:8080

# ========================================
# НАСТРОЙКИ БАЗЫ ДАННЫХ
# ========================================
# Обязательны: без базы бот не стартует — в ней очередь задач и расшифровки.
# Поднимается так: docker compose up -d postgres
DB_HOST=localhost
# 5433, а не 5432: стандартный порт часто занят другим Postgres на той же машине
DB_PORT=5433
DB_NAME=bot_db
DB_USER=bot_user
DB_PASSWORD=смените_на_длинный_случайный

# ========================================
# НАСТРОЙКИ ЛОГИРОВАНИЯ
# ========================================
# Управляет ТОЛЬКО подробностью консоли и logs/app.log.
# Пофайловые логи задач (logs/jobs/job-<id>.log) всегда пишутся с полной
# детализацией, включая построчный вывод yt-dlp и Whisper.
LOG_LEVEL=INFO
